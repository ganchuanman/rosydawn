---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
}

const { title = 'Rosydawn' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="记录技术思考与实践的个人博客" />
		<title>{title}</title>
		<ViewTransitions />
		<script is:inline>
			(function() {
					function applyTheme() {
						try {
							var theme = localStorage.getItem('theme');
							if (theme === 'paper') {
								document.documentElement.setAttribute('data-theme', 'paper');
							} else if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
								document.documentElement.setAttribute('data-theme', 'dark');
							} else {
								document.documentElement.removeAttribute('data-theme');
						}
					} catch (e) {}
				}
				applyTheme();
				document.addEventListener('astro:after-swap', applyTheme);
			})();
		</script>
	</head>
	<body>
		<slot />
		<script is:inline>
				(function() {
					function currentTheme() {
						return document.documentElement.getAttribute('data-theme') || 'light';
					}

					function updateToggleIcon(btn) {
						if (!btn) return;
						var theme = currentTheme();
						var nextLabel = theme === 'light'
							? '切换到论文白主题'
							: theme === 'paper'
								? '切换到暗色主题'
								: '切换到浅蓝主题';
						btn.innerHTML = theme === 'light'
							? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6"/><path d="M9 13h6"/><path d="M9 17h6"/></svg>'
							: theme === 'paper'
								? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>'
								: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
						btn.setAttribute('aria-label', nextLabel);
						btn.setAttribute('title', nextLabel);
					}
					document.addEventListener('astro:page-load', function() {
						var btn = document.querySelector('.theme-toggle');
						if (!btn) return;
						updateToggleIcon(btn);
						btn.addEventListener('click', function() {
							var theme = currentTheme();
							if (theme === 'light') {
								document.documentElement.setAttribute('data-theme', 'paper');
								try { localStorage.setItem('theme', 'paper'); } catch (e) {}
							} else if (theme === 'paper') {
								document.documentElement.setAttribute('data-theme', 'dark');
								try { localStorage.setItem('theme', 'dark'); } catch (e) {}
							} else {
								document.documentElement.removeAttribute('data-theme');
								try { localStorage.setItem('theme', 'light'); } catch (e) {}
							}
							updateToggleIcon(btn);
						});
				});
			})();
		</script>
		<script>
			let mermaidModule;
			let mermaidRenderQueue = Promise.resolve();
			let mermaidRenderScheduled = false;
			let renderCounter = 0;

				async function loadMermaid() {
					if (!mermaidModule) {
						try {
							mermaidModule = (await import('mermaid')).default;
						} catch (error) {
							mermaidModule = undefined;
							throw error;
						}
					}
					return mermaidModule;
				}

				function decodeSource(encoded) {
					const binary = atob(encoded);
					const bytes = new Uint8Array(binary.length);
					for (let i = 0; i < binary.length; i++) {
						bytes[i] = binary.charCodeAt(i);
					}
					return new TextDecoder('utf-8').decode(bytes);
				}

				function currentMermaidTheme() {
					return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'default';
				}

				function configureMermaid(mermaid) {
					mermaid.initialize({
						startOnLoad: false,
						securityLevel: 'strict',
						theme: currentMermaidTheme(),
						fontFamily: getComputedStyle(document.documentElement).getPropertyValue('--font-sans').trim(),
					});
				}

				function setLoading(container) {
					container.classList.remove('mermaid-error');
					container.classList.add('mermaid-rendering');
					container.replaceChildren();
					const loading = document.createElement('div');
					loading.className = 'mermaid-loading';
					loading.textContent = '渲染图表中...';
					container.appendChild(loading);
				}

				function renderWithTimeout(promise, timeoutMs = 8000) {
					let timeoutId;
					const timeout = new Promise((_, reject) => {
						timeoutId = window.setTimeout(() => reject(new Error('Mermaid render timeout')), timeoutMs);
					});
					return Promise.race([promise, timeout]).finally(() => window.clearTimeout(timeoutId));
				}

				function setError(container, source, messageText = 'Mermaid 图表渲染失败，请检查语法。') {
					container.classList.remove('mermaid-rendering');
					container.classList.add('mermaid-error');
					container.replaceChildren();

					const message = document.createElement('p');
					message.className = 'mermaid-error-text';
					message.textContent = messageText;

					const pre = document.createElement('pre');
					const code = document.createElement('code');
					code.textContent = source;
					pre.appendChild(code);

					container.append(message, pre);
				}

				async function renderMermaidDiagrams() {
					const diagrams = document.querySelectorAll('.mermaid-diagram[data-mermaid-source]');
					if (diagrams.length === 0) return;

					let mermaid;
					try {
						mermaid = await loadMermaid();
						configureMermaid(mermaid);
					} catch {
						diagrams.forEach((container) => {
							const encoded = container.getAttribute('data-mermaid-source');
							const source = encoded ? decodeSource(encoded) : '';
							setError(container, source, 'Mermaid 运行时加载失败，请刷新页面重试。');
						});
						return;
					}
					const theme = currentMermaidTheme();

					for (const container of diagrams) {
						const encoded = container.getAttribute('data-mermaid-source');
						if (!encoded) continue;
						if (container.getAttribute('data-rendered-theme') === theme) continue;

						const source = decodeSource(encoded);
						setLoading(container);

						try {
							const id = `mermaid-${Date.now()}-${renderCounter++}`;
							const result = await renderWithTimeout(mermaid.render(id, source));
							container.classList.remove('mermaid-rendering', 'mermaid-error');
							container.setAttribute('data-rendered-theme', theme);
							container.replaceChildren();
							const svg = document.createElement('div');
							svg.className = 'mermaid-svg';
							svg.innerHTML = result.svg;
							container.appendChild(svg);
							result.bindFunctions?.(container);
						} catch {
							container.removeAttribute('data-rendered-theme');
							setError(container, source);
						}
					}
				}

			function scheduleMermaidRender() {
				if (mermaidRenderScheduled) return;
				mermaidRenderScheduled = true;
				requestAnimationFrame(() => {
					mermaidRenderScheduled = false;
					mermaidRenderQueue = mermaidRenderQueue
						.catch(() => {})
						.then(() => renderMermaidDiagrams());
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', scheduleMermaidRender);
			} else {
				scheduleMermaidRender();
			}
			document.addEventListener('astro:page-load', scheduleMermaidRender);

			new MutationObserver(scheduleMermaidRender).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['data-theme'],
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #f4f9ff;
		--bg-secondary: #eaf4ff;
		--bg-tertiary: #dcecff;
		--surface: #ffffff;
		--surface-muted: #f7fbff;
		--chip-bg: #e8f3ff;
		--text: #142033;
		--text-muted: #506176;
		--text-dim: #8293a8;
		--accent: #2563eb;
		--accent-strong: #0f5fc6;
		--accent-dim: #164f9f;
		--accent-light: rgba(37, 99, 235, 0.16);
		--border: rgba(48, 112, 180, 0.16);
		--border-light: rgba(48, 112, 180, 0.1);
		--code-bg: #edf6ff;
		--shadow-soft: 0 14px 30px rgba(30, 96, 160, 0.08);
		--shadow-glow: 0 16px 34px rgba(37, 99, 235, 0.14);
		/* 使用系统等宽字体，零网络请求，首屏秒开 */
		--font-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
		--font-sans: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Arial, sans-serif;
	}

		html[data-theme="dark"] {
			--bg: #07111f;
			--bg-secondary: #0d1b2d;
			--bg-tertiary: #12263d;
		--surface: #0f1d30;
		--surface-muted: #142640;
		--chip-bg: #15304f;
		--text: #eef7ff;
		--text-muted: #b7c9dc;
		--text-dim: #7890a8;
		--accent: #7db7ff;
		--accent-strong: #a9d3ff;
		--accent-dim: #c3e1ff;
		--accent-light: rgba(125, 183, 255, 0.2);
		--border: rgba(180, 214, 255, 0.18);
		--border-light: rgba(180, 214, 255, 0.1);
		--code-bg: #0a1728;
			--shadow-soft: 0 18px 42px rgba(0, 0, 0, 0.24);
			--shadow-glow: 0 16px 36px rgba(85, 153, 255, 0.16);
		}

		html[data-theme="paper"] {
			--bg: #ffffff;
			--bg-secondary: #f7f7f4;
			--bg-tertiary: #eeeeea;
			--surface: #ffffff;
			--surface-muted: #fafaf8;
			--chip-bg: #f1f1ed;
			--text: #151515;
			--text-muted: #55524d;
			--text-dim: #89857e;
			--accent: #1f4f82;
			--accent-strong: #163f68;
			--accent-dim: #2f5f8f;
			--accent-light: rgba(31, 79, 130, 0.16);
			--border: rgba(20, 20, 20, 0.16);
			--border-light: rgba(20, 20, 20, 0.08);
			--code-bg: #f6f6f3;
			--shadow-soft: none;
			--shadow-glow: none;
			--font-sans: ui-serif, Georgia, 'Times New Roman', 'Songti SC', 'Noto Serif CJK SC', 'Source Han Serif SC', serif;
		}

	*, *::before, *::after {
		box-sizing: border-box;
	}

	html {
		font-family: var(--font-sans);
		background: var(--bg);
		color: var(--text);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	html, body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100vh;
	}

	body {
		background: var(--bg);
	}

	::selection {
		background: var(--accent);
		color: white;
	}

	/* Scrollbar styling */
	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}

	::-webkit-scrollbar-track {
		background: var(--bg);
	}

	::-webkit-scrollbar-thumb {
		background: var(--border);
		border-radius: 4px;
	}

	::-webkit-scrollbar-thumb:hover {
		background: var(--text-muted);
	}

	/* Links */
	a {
		color: var(--accent);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	/* Code */
	code {
		font-family: var(--font-mono);
	}

	/* Diagram Styles */
	.diagram {
		margin: 0.5rem 0;
		text-align: center;
	}

	.diagram img {
		max-width: 100%;
		height: auto;
		border-radius: 8px;
		background: white;
		padding: 1rem;
		border: 1px solid var(--border);
	}

	.diagram iframe {
		max-width: 100%;
	}

		.mermaid-diagram {
			margin: 1.35rem 0;
			padding: 1rem;
			overflow-x: auto;
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: 8px;
		}

		.mermaid-diagram.mermaid-zoom-ready {
			cursor: zoom-in;
			user-select: none;
			-webkit-user-select: none;
		}

		.mermaid-svg {
			min-width: max-content;
		}

	.mermaid-diagram svg {
		display: block;
		max-width: 100%;
			height: auto;
			margin: 0 auto;
		}

		.mermaid-diagram.mermaid-zoom-ready svg,
		.mermaid-diagram.mermaid-zoom-ready svg * {
			pointer-events: none;
			user-select: none;
			-webkit-user-select: none;
		}

	.mermaid-loading {
		padding: 2rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-muted);
		text-align: center;
	}

	.mermaid-error {
		border-color: rgba(220, 38, 38, 0.28);
	}

	.mermaid-error-text {
		margin: 0 0 0.75rem;
		color: #dc2626;
		font-size: 0.9rem;
	}

	.mermaid-error pre {
		margin: 0;
		padding: 0.85rem;
		overflow-x: auto;
		background: var(--code-bg);
		border: 1px solid var(--border-light);
		border-radius: 6px;
	}

	.mermaid-error code {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		white-space: pre;
	}

	.drawio-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		padding: 2rem;
		background: var(--bg-secondary);
		border: 2px dashed var(--border);
		border-radius: 8px;
		color: var(--text-muted);
	}

	.drawio-placeholder svg {
		opacity: 0.5;
	}

	.drawio-filename,
	.drawio-desc {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		margin: 0;
		color: var(--text-muted);
	}

	.drawio-open-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--accent);
		background: var(--bg);
		border: 1px solid var(--accent);
		border-radius: 6px;
		text-decoration: none;
		transition: all 0.2s;
	}

	.drawio-open-btn:hover {
		background: var(--accent);
		color: white;
		text-decoration: none;
	}

	/* Theme toggle */
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		background: transparent;
		border: 1px solid var(--border);
		border-radius: 6px;
		cursor: pointer;
		color: var(--text-muted);
		transition: all 0.2s;
		flex-shrink: 0;
	}

	.theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	/* Shiki dual theme: activate dark colors when data-theme="dark" */
	html[data-theme="dark"] .astro-code,
	html[data-theme="dark"] .astro-code span {
		color: var(--shiki-dark) !important;
		background-color: var(--shiki-dark-bg) !important;
	}
</style>
