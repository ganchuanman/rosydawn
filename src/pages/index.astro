---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostList from '../components/PostList.astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const pageSize = 5;
const totalPosts = sortedPosts.length;
const lastPage = Math.ceil(totalPosts / pageSize);
const pageData = sortedPosts.slice(0, pageSize);

const page = {
  data: pageData,
  currentPage: 1,
  lastPage,
  total: totalPosts,
  url: {
    prev: undefined,
    next: lastPage > 1 ? '/blog/2' : undefined,
  },
};
---

<Layout title="Rosydawn">
  <main class="container">
    <Header currentPath="/" />

    <section class="signal">
      <p class="eyebrow">STATIC BLOG</p>
      <h1>Rosydawn</h1>
      <p class="intro">记录技术判断、系统设计和构建手记。</p>
      <div class="metrics" aria-label="站点统计">
        <span>{page.total} posts</span>
        <span>{page.lastPage} pages</span>
        <span>Astro static</span>
      </div>
    </section>

    <PostList posts={page.data} source="home" />

    {(page.url.prev || page.url.next) && (
      <nav class="pagination">
        <div class="pagination-info">
          <span>第 {page.currentPage} / {page.lastPage} 页</span>
          <span class="pagination-total">共 {page.total} 篇文章</span>
        </div>
        <div class="pagination-links">
          {page.url.next ? (
            <a href={page.url.next} class="pagination-link next">
              <span>下一页</span>
              <span class="arrow">→</span>
            </a>
          ) : (
            <span class="pagination-link disabled">
              <span>下一页</span>
              <span class="arrow">→</span>
            </span>
          )}
        </div>
      </nav>
    )}

    <Footer />
  </main>
</Layout>

<style>
  .container {
    width: min(920px, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2rem 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .signal {
    position: relative;
    margin-bottom: 1.2rem;
    padding: 1.2rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .intro {
    max-width: 42rem;
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .metrics span {
    padding-right: 0.75rem;
    border-right: 1px solid var(--border);
  }

  .metrics span:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .pagination {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1.5rem;
    padding-top: 0.6rem;
  }

  .pagination-info,
  .pagination-links {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
  }

  .pagination-info {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .pagination-total {
    color: var(--text-dim);
  }

  .pagination-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0;
    color: var(--text);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .pagination-link:hover:not(.disabled) {
    color: var(--accent);
    border-bottom-color: var(--accent);
    text-decoration: none;
  }

  .pagination-link.disabled {
    color: var(--text-dim);
    opacity: 0.55;
  }

  @media (max-width: 640px) {
    .container {
      width: min(100vw - 1rem, 920px);
      padding: 1rem 0;
    }

    .signal { padding: 0.9rem 0 1.2rem; }

    h1 {
      font-size: 1.8rem;
    }
  }
</style>
