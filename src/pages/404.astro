---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { withBase } from '../lib/paths';

const currentPath = Astro.url.pathname;
const homeHref = withBase('/');
---

<Layout title="404 Not Found | Rosydawn">
  <main class="container">
    <section class="signal">
      <div class="signal-row">
        <div class="signal-content">
          <h1>Rosydawn</h1>
          <p class="intro">Learning, Practicing, and Looping</p>
        </div>

        <Header currentPath={currentPath} integrated hideLogo />
      </div>
    </section>

    <section class="error-page" aria-labelledby="error-title">
      <p class="eyebrow">NOT FOUND</p>
      <h2 id="error-title">页面不存在或已被移动</h2>
      <p class="message">这篇文章可能已经调整了归档路径，可以返回列表继续浏览。</p>
      <a href={homeHref} class="back-link">返回</a>
    </section>
  </main>
</Layout>

<style>
  .container {
    width: min(920px, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2rem 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .signal {
    position: relative;
    padding: 1.35rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .signal-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .signal-content {
    min-width: 0;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .intro {
    max-width: 42rem;
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .error-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 4rem 0;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .error-page h2 {
    margin: 0;
    color: var(--text);
    font-size: 2rem;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .message {
    max-width: 34rem;
    margin: 0.9rem 0 1.4rem;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }

  .back-link::before {
    content: "←";
    margin-right: 0.45rem;
    font-family: var(--font-mono);
  }

  .back-link:hover {
    border-bottom-color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .container {
      width: min(100vw - 1rem, 920px);
      padding: 1rem 0;
    }

    .signal { padding: 1rem 0 1.2rem; }

    .signal-row {
      flex-direction: column;
      gap: 1rem;
    }

    h1 {
      font-size: 1.8rem;
    }

    .error-page {
      padding: 3rem 0;
      justify-content: flex-start;
    }

    .error-page h2 {
      font-size: 1.5rem;
    }
  }
</style>
