---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostList from '../../components/PostList.astro';

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('posts');
  const sortedPosts = posts.sort((a, b) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );
  const allPages = paginate(sortedPosts, { pageSize: 5 });
  return allPages.filter(page => page.params.page !== undefined);
}

const { page } = Astro.props;
const currentPath = `/blog/${page.currentPage}`;
---

<Layout title={`Blog - Page ${page.currentPage} | Rosydawn`}>
  <main class="container">
    <Header currentPath="/" />

    <section class="page-head">
      <p class="eyebrow">ARCHIVE NODE</p>
      <h1>文章流 · 第 {page.currentPage} 页</h1>
      <p>{page.total} 篇静态归档，按发布时间倒序排列。</p>
    </section>

    <PostList posts={page.data} source="blog-list" refPath={currentPath} />

    {(page.url.prev || page.url.next) && (
      <nav class="pagination">
        <div class="pagination-info">
          <span>第 {page.currentPage} / {page.lastPage} 页</span>
          <span class="pagination-total">共 {page.total} 篇文章</span>
        </div>
        <div class="pagination-links">
          {page.url.prev ? (
            <a href={page.currentPage === 2 ? '/' : page.url.prev} class="pagination-link prev">
              <span class="arrow">←</span>
              <span>上一页</span>
            </a>
          ) : (
            <span class="pagination-link disabled">
              <span class="arrow">←</span>
              <span>上一页</span>
            </span>
          )}
          {page.url.next ? (
            <a href={page.url.next} class="pagination-link next">
              <span>下一页</span>
              <span class="arrow">→</span>
            </a>
          ) : (
            <span class="pagination-link disabled">
              <span>下一页</span>
              <span class="arrow">→</span>
            </span>
          )}
        </div>
      </nav>
    )}

    <Footer />
  </main>
</Layout>

<style>
  .container {
    width: min(920px, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2rem 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .page-head {
    margin-bottom: 1.2rem;
    padding: 1rem 0 1.2rem;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent-strong);
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: 1.65rem;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .page-head p:last-child {
    margin: 0.55rem 0 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .pagination {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1.5rem;
    padding-top: 0.6rem;
  }

  .pagination-info,
  .pagination-links {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
  }

  .pagination-info {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .pagination-total {
    color: var(--text-dim);
  }

  .pagination-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0;
    color: var(--text);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .pagination-link:hover:not(.disabled) {
    color: var(--accent);
    border-bottom-color: var(--accent);
    text-decoration: none;
  }

  .pagination-link.disabled {
    color: var(--text-dim);
    opacity: 0.55;
  }

  @media (max-width: 640px) {
    .container {
      width: min(100vw - 1rem, 920px);
      padding: 1rem 0;
    }

    .pagination-links {
      flex-direction: column;
    }

    .pagination-link {
      justify-content: center;
    }
  }
</style>
