---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { withBase } from '../../lib/paths';

const posts = await getCollection('posts');
const postsByTag = new Map<string, typeof posts>();
const sortedPosts = posts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

sortedPosts.forEach(post => {
  post.data.tags?.forEach(tag => {
    const tagPosts = postsByTag.get(tag) || [];
    tagPosts.push(post);
    postsByTag.set(tag, tagPosts);
  });
});

const sortedTagGroups = Array.from(postsByTag.entries()).sort((a, b) =>
  b[1].length - a[1].length || a[0].localeCompare(b[0])
);
---

<Layout title="Tags | Rosydawn">
  <main class="container">
    <section class="signal">
      <div class="signal-row">
        <div class="signal-content">
          <h1>Rosydawn</h1>
          <p class="intro">Learning, Practicing, and Looping</p>
        </div>

        <Header currentPath="/tags" integrated hideLogo />
      </div>
    </section>

    <section class="tag-groups" aria-label="分类文章列表">
      {sortedTagGroups.map(([tag, tagPosts]) => (
        <article class="tag-group">
          <div class="tag-heading">
            <span class="tag-name">{tag}</span>
            <span class="tag-count">{tagPosts.length}</span>
          </div>
          <ul class="tag-posts">
            {tagPosts.map((post) => (
              <li>
                <a href={withBase(`/blog/${post.id}`)}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>
  </main>
</Layout>

<style>
  .container {
    width: min(920px, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2rem 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .signal {
    position: relative;
    padding: 1.35rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .signal-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .signal-content {
    min-width: 0;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .intro {
    max-width: 42rem;
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .tag-groups {
    flex: 1;
  }

  .tag-group {
    padding: 1.05rem 0 1.15rem;
    border-bottom: 1px solid var(--border);
  }

  .tag-heading {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.15rem 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.86rem;
  }

  .tag-count {
    min-width: 1.35rem;
    padding: 0.12rem 0.35rem;
    color: var(--accent-strong);
    background: var(--chip-bg);
    border: 1px solid var(--border-light);
    border-radius: 999px;
    font-size: 0.72rem;
    text-align: center;
  }

  .tag-posts {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.5rem;
    row-gap: 0.45rem;
    margin: 0.65rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tag-posts li {
    min-width: 0;
  }

  .tag-posts a {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    color: var(--text);
    background: var(--surface-muted);
    border: 1px solid var(--border-light);
    border-radius: 4px;
    font-size: 14px;
    line-height: 22px;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .tag-posts a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
    border-color: var(--accent);
    background: var(--bg);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .container {
      width: min(100vw - 1rem, 920px);
      padding: 1rem 0;
    }

    .signal { padding: 1rem 0 1.2rem; }

    .signal-row {
      flex-direction: column;
      gap: 1rem;
    }

    h1 {
      font-size: 1.8rem;
    }

    .tag-group {
      padding: 0.95rem 0 1rem;
    }
  }
</style>
