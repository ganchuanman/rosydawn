---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = await getCollection('posts');
const tagMap = new Map<string, number>();
posts.forEach(post => {
  post.data.tags?.forEach(tag => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});

const sortedTags = Array.from(tagMap.entries()).sort((a, b) => b[1] - a[1]);
---

<Layout title="Tags | Rosydawn">
  <main class="container">
    <Header currentPath="/tags" />

    <section class="page-head">
      <p class="eyebrow">TOPIC MAP</p>
      <h1>分类索引</h1>
      <p>从标签进入文章簇，快速回到同一组技术语境。</p>
    </section>

    <section class="tags-cloud">
      {sortedTags.map(([tag, count]) => (
        <a href={`/tags/${tag}?from=tag-list`} class="tag-item">
          <span class="tag-name">{tag}</span>
          <span class="tag-count">{count}</span>
        </a>
      ))}
    </section>

    <Footer />
  </main>
</Layout>

<style>
  .container {
    width: min(920px, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2rem 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .page-head {
    margin-bottom: 1.2rem;
    padding: 1rem 0 1.2rem;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent-strong);
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: 1.65rem;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .page-head p:last-child {
    margin: 0.55rem 0 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .tags-cloud {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-content: flex-start;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }

  .tag-item:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
    text-decoration: none;
  }

  .tag-count {
    min-width: 1.35rem;
    padding: 0.12rem 0.35rem;
    color: var(--accent-strong);
    background: var(--chip-bg);
    border: 1px solid var(--border-light);
    border-radius: 999px;
    font-size: 0.72rem;
    text-align: center;
  }

  @media (max-width: 640px) {
    .container {
      width: min(100vw - 1rem, 920px);
      padding: 1rem 0;
    }

    .tags-cloud {
      gap: 0.5rem;
    }
  }
</style>
