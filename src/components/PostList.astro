---
interface Props {
  posts: any[];
}

const { posts } = Astro.props;

function formatDate(date: Date): string {
  return date.toISOString().split('T')[0];
}

function postHref(id: string): string {
  return `/blog/${id}`;
}
---

<section class="posts">
  <div class="post-list">
  {posts.map((post) => (
    <article class="post-item">
      <a href={postHref(post.id)}>
        <h3 class="post-title">{post.data.title}</h3>
        <p class="post-desc">{post.data.description}</p>
        <div class="post-meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {post.data.tags?.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </a>
    </article>
  ))}
  </div>
</section>

<style>
  .posts {
    padding: 4.65rem 0 5rem;
  }

  .post-list {
    display: grid;
    gap: 3.25rem;
  }

  .post-item {
    position: relative;
    padding-left: 2.25rem;
  }

  .post-item::before {
    content: '';
    position: absolute;
    top: 0.7rem;
    left: 0.2rem;
    width: 0.38rem;
    height: 0.38rem;
    background: var(--text-muted);
    border-radius: 50%;
  }

  .post-item a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .post-item a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0.5rem;
  }

  .post-title {
    margin: 0 0 0.55rem;
    color: var(--accent);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.45;
    transition: color 0.2s;
  }

  .post-item a:hover .post-title {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .post-desc {
    max-width: 58rem;
    margin: 0 0 0.7rem;
    color: var(--text-muted);
    font-size: 1rem;
    font-style: italic;
    line-height: 1.75;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    color: var(--text-dim);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .post-meta > * + *::before {
    content: '·';
    margin: 0 0.55rem;
    color: var(--text-dim);
  }

  .tag {
    color: inherit;
  }

  @media (max-width: 640px) {
    .posts {
      padding: 3rem 0 0;
    }

    .post-list {
      gap: 2.6rem;
    }

    .post-item {
      padding-left: 1.45rem;
    }

    .post-item::before {
      left: 0;
      width: 0.32rem;
      height: 0.32rem;
    }

    .post-title {
      font-size: 1.17rem;
    }

    .post-desc {
      font-size: 0.94rem;
      line-height: 1.7;
    }

    .post-meta {
      font-size: 0.78rem;
    }
  }
</style>
